<Page
    x:Class="CPCRemote.UI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CPCRemote.UI.Controls"
    xmlns:vm="using:CPCRemote.UI.ViewModels"
    xmlns:helpers="using:CPCRemote.UI.Helpers"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
             <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="True"/>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <!-- Card Style -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource UltraGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLightingBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,24"/>
            <!-- Implicit Animations for smooth entry -->
            <Setter Property="animations:Implicit.ShowAnimations">
                <Setter.Value>
                    <animations:ImplicitAnimationSet>
                        <animations:TranslationAnimation Duration="0:0:0.6" From="0,20,0" To="0,0,0" />
                        <animations:OpacityAnimation Duration="0:0:0.6" From="0" To="1.0"/>
                    </animations:ImplicitAnimationSet>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="DASHBOARD" Style="{StaticResource HyperTitleTextBlockStyle}" FontSize="28"/>
                <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" Foreground="{ThemeResource VibrantMesh}"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <ComboBox ItemsSource="{x:Bind ViewModel.PollingIntervalOptions, Mode=OneWay}" 
                          SelectedValue="{x:Bind ViewModel.PollingIntervalSeconds, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Seconds"
                          Width="100" VerticalAlignment="Center"/>
                          
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsPollingEnabled, Mode=TwoWay}" 
                              OffContent="Paused" OnContent="Live" 
                              VerticalAlignment="Center"/>
                              
                <Button Command="{x:Bind ViewModel.RefreshStatsCommand}" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Refresh Now">
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="32">
                <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/> <!-- Service Status -->
                     <RowDefinition Height="Auto"/> <!-- Dynamic Sensors (new) -->
                     <RowDefinition Height="Auto"/> <!-- CPU (legacy) -->
                     <RowDefinition Height="Auto"/> <!-- GPU (legacy) -->
                     <RowDefinition Height="Auto"/> <!-- Memory + Mobo (legacy) -->
                </Grid.RowDefinitions>

                <!-- Service Status Bar -->
                <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                     <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{x:Bind ViewModel.IsServiceConnected, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.ServiceUptime, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.HttpListenerAddress, Mode=OneWay}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
                    </Grid>
                </Border>

                <!-- ===== DYNAMIC GADGET SENSORS ===== -->
                <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.UseDynamicDashboard, Mode=OneWay}">
                    <!-- Section Header with Edit Toggle -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HWINFO GADGET SENSORS" Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GadgetSensors.Count, Mode=OneWay}" 
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        
                        <!-- Edit/Done Button -->
                        <ToggleButton Grid.Column="2" 
                                      IsChecked="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                                      Padding="8,4"
                                      CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToEditGlyphConverter}}" FontSize="14"/>
                                <TextBlock Text="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToEditTextConverter}}" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                    
                    <!-- Dynamic Sensor List (ListView with manual reordering) -->
                    <ListView x:Name="SensorListView"
                              ItemsSource="{x:Bind ViewModel.GadgetSensors, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SensorCardViewModel">
                                <Grid ColumnSpacing="16" Padding="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Reorder Buttons -->
                                        <ColumnDefinition Width="Auto"/> <!-- Category bar -->
                                        <ColumnDefinition Width="*"/>    <!-- Label -->
                                        <ColumnDefinition Width="Auto"/> <!-- Value -->
                                        <ColumnDefinition Width="Auto"/> <!-- Visibility -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Reorder Buttons -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                                Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                                Padding="4" MinWidth="28" MinHeight="28"
                                                ToolTipService.ToolTip="Move Up"
                                                Command="{Binding DataContext.MoveSensorUpCommand, ElementName=SensorListView}"
                                                CommandParameter="{Binding}">
                                            <FontIcon Glyph="&#xE74A;" FontSize="12"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                                Padding="4" MinWidth="28" MinHeight="28"
                                                ToolTipService.ToolTip="Move Down"
                                                Command="{Binding DataContext.MoveSensorDownCommand, ElementName=SensorListView}"
                                                CommandParameter="{Binding}">
                                            <FontIcon Glyph="&#xE74B;" FontSize="12"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Category accent bar -->
                                    <Border Grid.Column="1" Width="4" Height="24" CornerRadius="2" 
                                            Background="{Binding CategoryBrush}"
                                            VerticalAlignment="Center"/>

                                    <!-- Sensor label -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5"/>
                                    </StackPanel>

                                    <!-- Current Value -->
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedValue}" 
                                               VerticalAlignment="Center" 
                                               FontWeight="SemiBold" 
                                               Foreground="{Binding CategoryBrush}"/>

                                    <!-- Visibility Toggle -->
                                    <CheckBox Grid.Column="4" 
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                              ToolTipService.ToolTip="Show/hide on dashboard"
                                              Padding="0" MinWidth="0"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="{ThemeResource UltraGlassBrush}"/>
                                <Setter Property="BorderBrush" Value="{ThemeResource EdgeLightingBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    
                    <!-- Empty State (shown when no sensors) -->
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Status Footer -->
         <Border Grid.Row="2" Margin="0,12,0,0">
             <!-- Optional footer -->
        </Border>
    </Grid>
</Page>
