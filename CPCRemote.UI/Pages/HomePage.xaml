<Page
    x:Class="CPCRemote.UI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CPCRemote.UI.Controls"
    xmlns:helpers="using:CPCRemote.UI.Helpers"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True"/>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <!-- Widget Card Style -->
        <Style x:Key="WidgetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource UltraGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource EdgeLightingBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Quick Action Button Style -->
        <Style x:Key="QuickActionCompactStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{ThemeResource GlassBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="helpers:CompositionBehavior.IsSpringAnimationEnabled" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Welcome Header -->
            <RowDefinition Height="Auto"/>  <!-- Quick Actions Bar -->
            <RowDefinition Height="*"/>     <!-- Widget Grid -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: Welcome Header ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <!-- Welcome Message -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}"
                               Style="{StaticResource HyperTitleTextBlockStyle}"
                               FontSize="28"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource VibrantMesh}"/>
                </StackPanel>

                <!-- System Status Subtitle -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse Width="8" Height="8"
                             Fill="{x:Bind ViewModel.IsServiceConnected, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>

            <!-- Right: Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                <ComboBox ItemsSource="{x:Bind ViewModel.PollingIntervalOptions, Mode=OneWay}"
                          SelectedValue="{x:Bind ViewModel.PollingIntervalSeconds, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Seconds"
                          Width="90" VerticalAlignment="Center"/>

                <ToggleSwitch IsOn="{x:Bind ViewModel.IsPollingEnabled, Mode=TwoWay}"
                              OffContent="Paused" OnContent="Live"
                              VerticalAlignment="Center"/>

                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Refresh Now">
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>

                <!-- Edit Mode Toggle -->
                <ToggleButton IsChecked="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                              Padding="8,6" CornerRadius="6"
                              ToolTipService.ToolTip="Edit dashboard layout">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToEditGlyphConverter}}" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToEditTextConverter}}" FontSize="12"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- ═══ ROW 1: Quick Actions Bar ═══ -->
        <Border Grid.Row="1" Style="{StaticResource WidgetCardStyle}" Margin="0,0,0,20" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <!-- Quick Action Buttons -->
                    <Button Style="{StaticResource QuickActionCompactStyle}"
                            ToolTipService.ToolTip="Lock PC"
                            Command="{x:Bind ViewModel.SendQuickActionCommand}"
                            CommandParameter="Lock">
                        <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="#FFDD44"/>
                    </Button>

                    <Button Style="{StaticResource QuickActionCompactStyle}"
                            ToolTipService.ToolTip="Restart"
                            Command="{x:Bind ViewModel.SendQuickActionCommand}"
                            CommandParameter="Restart">
                        <FontIcon Glyph="&#xE777;" FontSize="20" Foreground="#44AAFF"/>
                    </Button>

                    <Button Style="{StaticResource QuickActionCompactStyle}"
                            ToolTipService.ToolTip="Shutdown"
                            Command="{x:Bind ViewModel.SendQuickActionCommand}"
                            CommandParameter="Shutdown">
                        <FontIcon Glyph="&#xE7E8;" FontSize="20" Foreground="#FF4444"/>
                    </Button>

                    <Button Style="{StaticResource QuickActionCompactStyle}"
                            ToolTipService.ToolTip="Restart to UEFI/BIOS"
                            Command="{x:Bind ViewModel.SendQuickActionCommand}"
                            CommandParameter="UEFIReboot">
                        <FontIcon Glyph="&#xE770;" FontSize="20" Foreground="#BB77FF"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="36" Background="{ThemeResource GlassBorderBrush}" Margin="4,0"/>

                    <!-- Service Info -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock Text="Uptime:" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ServiceUptime, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Action Log (fades out) -->
                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.QuickActionLog, Mode=OneWay}"
                           FontSize="11" Opacity="0.6"
                           FontFamily="Consolas"
                           Margin="0,6,0,0"
                           Visibility="{x:Bind ViewModel.QuickActionLog, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ═══ ROW 2: Widget Grid (Sensors) ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Sensor Widgets -->
                <controls:VariableSizedGridView x:Name="WidgetGridView"
                          ItemsSource="{x:Bind ViewModel.Widgets, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <controls:VariableSizedGridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal"
                                           ItemWidth="240" ItemHeight="220"
                                           MaximumRowsOrColumns="10"
                                           HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </controls:VariableSizedGridView.ItemsPanel>
                    <controls:VariableSizedGridView.ItemTemplate>
                        <DataTemplate>
                            <controls:DashboardWidget DataContext="{Binding}" Margin="6"/>
                        </DataTemplate>
                    </controls:VariableSizedGridView.ItemTemplate>
                    <controls:VariableSizedGridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </controls:VariableSizedGridView.ItemContainerStyle>
                </controls:VariableSizedGridView>

                <!-- Empty State — only shown when there are no widgets -->
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,60"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE946;" FontSize="48" Opacity="0.3" HorizontalAlignment="Center"/>
                    <TextBlock Text="No sensor widgets to display"
                               FontSize="16" Opacity="0.5"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Configure sensors in the Sensor Config page"
                               FontSize="12" Opacity="0.3"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
