<UserControl
    x:Class="CPCRemote.UI.Controls.SensorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CPCRemote.UI.Controls"
    xmlns:helpers="using:CPCRemote.UI.Helpers"
    xmlns:vm="using:CPCRemote.UI.ViewModels"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SensorCardViewModel, IsDesignTimeCreatable=True}">

    <Border x:Name="CardBorder"
            Background="{ThemeResource UltraGlassBrush}"
            BorderBrush="{ThemeResource EdgeLightingBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            MinWidth="200"
            MinHeight="100"
            helpers:CompositionBehavior.IsSpringAnimationEnabled="True">

        <!-- Entry Animation -->
        <animations:Implicit.ShowAnimations>
            <animations:ImplicitAnimationSet>
                <animations:TranslationAnimation Duration="0:0:0.5" From="0,30,0" To="0,0,0" />
                <animations:OpacityAnimation Duration="0:0:0.5" From="0" To="1.0"/>
            </animations:ImplicitAnimationSet>
        </animations:Implicit.ShowAnimations>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Category Accent Bar + Label -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Colored accent bar -->
                <Border Grid.Column="0" 
                        CornerRadius="2"
                        Background="{Binding CategoryBrush}"
                        Margin="0,0,8,0"/>
                
                <!-- Sensor Label -->
                <TextBlock Grid.Column="1" 
                           Text="{Binding Label}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           ToolTipService.ToolTip="{Binding SensorName}"/>
            </Grid>

            <!-- Value Display: Large numeric value with unit -->
            <StackPanel Grid.Row="1" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="{Binding FormattedValue}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{Binding CategoryBrush}"
                           HorizontalAlignment="Center"
                           TextTrimming="None"/>
            </StackPanel>

            <!-- Category Badge -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Background="{Binding CategoryBrush}"
                        Opacity="0.2"
                        CornerRadius="4"
                        Padding="8,2"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Category}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{Binding CategoryBrush}"/>
                </Border>
                
                <!-- Edit Mode: Visibility Toggle -->
                <CheckBox Grid.Column="1" 
                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                          Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                          ToolTipService.ToolTip="Show/hide on dashboard"
                          Padding="0" MinWidth="0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
